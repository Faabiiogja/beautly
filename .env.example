NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só server-side. Ignora RLS: usar apenas nas rotas públicas de agendamento.
SUPABASE_SERVICE_ROLE_KEY=
# Em dev, use localhost (acesse ana.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=beautly.cloud

# Origem do painel usada no link de recuperação de senha. Em dev: http://localhost:3111 (a porta em uso)
NEXT_PUBLIC_PANEL_URL=https://painel.beautly.cloud

# E-mail transacional (Resend). Sem estas duas variáveis o app funciona, só não envia e-mail.
RESEND_API_KEY=
# Remetente. Precisa ser de um domínio verificado no Resend (ex.: Beautly <agenda@beautly.cloud>).
EMAIL_FROM=
